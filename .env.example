# Placeholders only — copy to .env.local and fill in locally.
# Never commit real credentials. Keys are read server-side only.

# Meta Model API (official docs: https://dev.meta.ai/docs)
# Base URL https://api.meta.ai/v1, POST /chat/completions, Bearer auth.
# Example model: muse-spark-1.3
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
META_API_BASE_URL=https://api.meta.ai/v1

# Scholarship search provider.
# Default no-cost option: Meta-native web search grounding via the
# Responses API web_search tool — reuses MODEL_API_KEY, no Brave key needed.
SEARCH_PROVIDER=meta
# Optional alternative (requires its own paid key):
# SEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=

# Optional: total discovery time budget in milliseconds (default 50000).
DISCOVERY_BUDGET_MS=90000

# Database (not used yet; reserved for later phases)
DATABASE_URL=
